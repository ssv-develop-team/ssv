REDIS_PORT=6379
# QDRANT_PORT=6333
# MinIO S3 API 与控制台端口（默认只绑定 127.0.0.1）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO root 凭据；不提供默认值。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Agent 使用的凭据；当前阶段与 root 凭据相同。
SSV_MINIO_ACCESS_KEY=
SSV_MINIO_SECRET_KEY=
SSV_MINIO_BUCKET=ssv-artifacts
# 可选：覆盖默认的共享 MinIO 镜像；留空时使用 GHCR 默认镜像，拉取失败会本地构建。
# SSV_MINIO_IMAGE=ghcr.io/ssv-develop-team/ssv-minio:RELEASE.2025-04-22T22-12-26Z
# 已有本地构建的 ssv-minio:minio 时可复用：
# SSV_MINIO_IMAGE=ssv-minio:minio
